{
  "name": "agrune-monorepo",
  "private": true,
  "version": "0.4.1",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" --if-present run typecheck && pnpm -r --filter \"./packages/*\" --if-present run build",
    "test": "pnpm -r --filter \"./packages/*\" --if-present run test",
    "test:e2e": "pnpm --filter @agrune/e2e run test:e2e",
    "test:e2e:install": "pnpm --filter @agrune/e2e run test:e2e:install"
  }
}
