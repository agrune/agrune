{
  "registry": {
    "host": "docs.python.org",
    "version": "1.0.0",
    "tier": "verified",
    "author": "agrune-maintainers",
    "submittedAt": "2026-04-20T00:00:00.000Z",
    "reviewedBy": ["agrune-maintainers"],
    "allowedEnvironments": ["dev", "prod"],
    "seedUrl": "https://docs.python.org"
  },
  "manifest": {
    "version": 3,
    "groups": [
      {
        "groupId": "search",
        "name": "Docs search + version switcher",
        "targets": [
          {
            "targetId": "searchInput",
            "name": "Search input",
            "actionKinds": ["fill"],
            "selector": {
              "role": { "name": "searchbox" }
            }
          },
          {
            "targetId": "versionSwitcher",
            "name": "Python version switcher",
            "actionKinds": ["click"],
            "selector": {
              "css": "select#version_switcher_placeholder, select[id*=\"version\"]"
            }
          }
        ]
      }
    ]
  }
}
