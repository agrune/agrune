{
  "name": "@agrune/core",
  "version": "0.4.1",
  "description": "Shared types, errors, and config helpers for agrune",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./annotation-lint": {
      "types": "./dist/annotation-lint.d.ts",
      "import": "./dist/annotation-lint.js"
    },
    "./annotation-lint/vite-plugin": {
      "types": "./dist/annotation-lint-vite-plugin.d.ts",
      "import": "./dist/annotation-lint-vite-plugin.js"
    }
  },
  "bin": {
    "agrune-lint": "./bin/agrune-lint.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@agrune/manifest": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
